# ====================================================================
# BHARATCONTENT AI - ENVIRONMENT CONFIGURATION (.env)
# Team: GRAMX | SIH Problem Statement ID: SIH26154
# ====================================================================

# --------------------------------------------------------------------
# 1. PRIMARY LLM PROVIDER: GOOGLE GEMINI (RECOMMENDED - FREE TIER)
# Get free API key: https://aistudio.google.com/app/apikey
# Free tier gives: 15 Requests/min, 1M context tokens, multimodal
# --------------------------------------------------------------------
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------
# 2. ALTERNATIVE LLM PROVIDER: OPENAI (OPTIONAL)
# Get API key: https://platform.openai.com/api-keys
# --------------------------------------------------------------------
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------
# 3. DATABASE & VECTOR STORAGE: SUPABASE / POSTGRESQL (FREE TIER)
# Create free project: https://supabase.com/dashboard
# Features: Native PostgreSQL, pgvector embedding storage, Document Storage
# --------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --------------------------------------------------------------------
# 4. BHASHINI / MEITY INDIAN LANGUAGE TRANSLATION (OPTIONAL)
# National Language Translation Mission (NLTM) - Bhashini
# Sign up: https://bhashini.gov.in/en/
# --------------------------------------------------------------------
VITE_BHASHINI_USER_ID=
VITE_BHASHINI_API_KEY=
VITE_BHASHINI_PIPELINE_ID=

# --------------------------------------------------------------------
# 5. RUNTIME ENVIRONMENT
# --------------------------------------------------------------------
VITE_APP_TITLE=BharatContent AI
VITE_APP_ENV=development
